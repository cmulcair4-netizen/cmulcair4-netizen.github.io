<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192">
  <defs>
    <style>
      .bg { fill: linear-gradient(135deg, #d4a5e8, #a5d8e8); }
      .text { font-family: Arial, sans-serif; font-weight: bold; fill: white; }
    </style>
  </defs>
  <!-- Background -->
  <rect width="192" height="192" class="bg"/>
  <!-- Safe area background -->
  <rect x="10" y="10" width="172" height="172" rx="40" fill="white" opacity="0.95"/>
  <!-- Gradient overlay -->
  <rect x="10" y="10" width="172" height="172" rx="40" fill="url(#grad)" opacity="0.1"/>
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d4a5e8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#a5d8e8;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Icon content -->
  <text x="96" y="110" font-size="72" font-weight="bold" text-anchor="middle" fill="url(#grad)">🔥</text>
  <!-- Text -->
  <text x="96" y="150" font-size="18" font-weight="bold" text-anchor="middle" fill="#2d2d2d" font-family="Arial">FlipForge</text>
</svg>