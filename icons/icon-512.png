<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#d4a5e8;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#a5d8e8;stop-opacity:1" />
    </linearGradient>
  </defs>
  <!-- Background -->
  <rect width="512" height="512" fill="url(#grad)"/>
  <!-- Safe area background -->
  <rect x="32" y="32" width="448" height="448" rx="100" fill="white" opacity="0.98"/>
  <!-- Icon content -->
  <text x="256" y="290" font-size="200" font-weight="bold" text-anchor="middle" fill="url(#grad)">🔥</text>
  <!-- Text -->
  <text x="256" y="400" font-size="60" font-weight="bold" text-anchor="middle" fill="#2d2d2d" font-family="Arial">FlipForge</text>
</svg>